# FinSight AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finsight

# Authentication
JWT_SECRET_KEY=change_this_secret_super_secure_key_for_finsight_ai_testing_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider: "groq" for cloud hosting, "ollama" for local GPU
LLM_PROVIDER=groq

# Groq Cloud LLM (Supports multiple comma-separated keys for fault-tolerant failover)
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_API_KEY=gsk_key1
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama LLM Configuration (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Guardrail Security Mode: "basic" (vulnerable to adversarial roleplay) or "hardened" (Level-2 defense)
GUARDRAIL_MODE=basic

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["*"]

# Rate Limiting (requests per minute per user)
CHAT_RATE_LIMIT=60

