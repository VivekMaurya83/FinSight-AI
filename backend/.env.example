# FinSight AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finsight

# Authentication
JWT_SECRET_KEY=change_this_secret_super_secure_key_for_finsight_ai_testing_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Rate Limiting (requests per minute per user)
CHAT_RATE_LIMIT=20
